__inventory
.idea/*
*.db
__debug_bin
node_modules/
.DS_Store

# docker compose runtime logs (keep README.md placeholder tracked)
docker-compose/**/logs/*.log

# DataService runtime state written next to its config (see src/DataService/Config/state.go)
docker-compose/**/state.json
# DataService ssh identity (private key + known_hosts) generated next to its config for the git channel
docker-compose/**/ssh/
# shared-mirror demos: everything but the templates is generated (configs with the MongoDB password, keys, data, channel)
docker-compose/shared-mirror*/site-*/ds/config/*
!docker-compose/shared-mirror*/site-*/ds/config/config.template.json
docker-compose/shared-mirror*/site-*/*/data/
docker-compose/shared-mirror*/.env
docker-compose/shared-mirror/exchange/
docker-compose/shared-mirror-git/remote/
