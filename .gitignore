__inventory
.idea/*
*.db
__debug_bin
node_modules/
.DS_Store

# docker compose runtime logs (keep README.md placeholder tracked)
docker-compose/**/logs/*.log
# the templates are deployed into other directories by docker-compose/script/*_deploy.sh;
# if a deployment ends up inside the repository, keep what it writes out of git (passwords, keys, state, data)
docker-compose/**/.env
docker-compose/**/state.json
docker-compose/**/data/
docker-compose/template/*/config/config.json
docker-compose/template/*/config/vds/
docker-compose/template/*/channel/
