{
    "database": {
        "type": "mongodb",
        "mongodb": { "endpoint": "mongodb://mongodb:27017", "database": "SiteA", "user": "root", "password": "example" }
    },
    "table": { "data": "SiteA" },
    "http": { "type": "http", "dns": "site-a-ds", "port": "80", "id": "SiteA", "headers": {} },
    "ds": { "id": "SiteA", "urls": ["http://site-a-ds", "http://localhost:8011"] },
    "inventory": { "url": "http://site-a-inv" },
    "vds": {
        "local": {},
        "shared": [{
            "name": "catalog",
            "signingKeyFile": "/opt/UniTAO/keys/catalog.pem",
            "publishIntervalSec": 5,
            "subscriberTimeoutHours": 24,
            "compactIntervalHours": 24,
            "channel": {
                "type": "dir",
                "path": "/opt/UniTAO/exchange",
                "encrypt": { "recipientsFile": "/opt/UniTAO/keys/recipients" }
            }
        }]
    }
}
