# docker compose 的变量，复制为同目录的 .env 后填写（.env 不进 git）。
# 容器以这个用户运行，写出的文件都归该用户；不设置时以 root 运行。填 `id -u` / `id -g` 的输出。
UNITAO_UID=<uid>
UNITAO_GID=<gid>
# MongoDB 容器所在的 Docker 网络（docker network ls），默认 mongo_net
#UNITAO_MONGODB_NETWORK=mongo_net
# UniTAO 镜像，默认 ghcr.io/howeyhuo/unitao-dev:latest
#UNITAO_IMAGE=ghcr.io/howeyhuo/unitao-dev:latest
