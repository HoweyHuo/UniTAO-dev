{
    "database": {
        "type": "mongodb",
        "mongodb": { "endpoint": "mongodb://mongodb:27017", "database": "SiteB", "user": "root", "password": "example" }
    },
    "table": { "data": "SiteB" },
    "http": { "type": "http", "dns": "site-b-ds", "port": "80", "id": "SiteB", "headers": {} },
    "ds": { "id": "SiteB", "urls": ["http://site-b-ds", "http://localhost:8021"] },
    "inventory": { "url": "http://site-b-inv" },
    "vds": {
        "local": {},
        "mirrored": [{
            "name": "catalog",
            "trustedFingerprint": "<fingerprint of siteA signing key>",
            "pullIntervalSec": 10,
            "channel": {
                "type": "dir",
                "path": "/opt/UniTAO/exchange",
                "decrypt": { "identityFile": "/opt/UniTAO/keys/identity" }
            }
        }]
    }
}
