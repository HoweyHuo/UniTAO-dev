{
    "database": {
        "type": "dynamodb",
        "dynamodb": { "region": "us-west-2", "endpoint": "http://dynamodb:8000" }
    },
    "table": { "data": "SiteA" },
    "http": { "type": "http", "dns": "site-a-ds", "port": "80", "id": "SiteA", "headers": {} },
    "ds": { "id": "SiteA", "urls": ["http://site-a-ds", "http://localhost:8031"] },
    "inventory": { "url": "http://site-a-inv" },
    "vds": {
        "local": {},
        "shared": [{
            "name": "catalog",
            "signingKeyFile": "/opt/UniTAO/keys/catalog.pem",
            "publishIntervalSec": 5,
            "snapshotIntervalSec": 60,
            "channel": {
                "type": "git",
                "repo": "file:///opt/UniTAO/remote/exchange.git",
                "branch": "main",
                "workDir": "/opt/UniTAO/channel/catalog"
            }
        }]
    }
}
