# Inventory Service 实例的 docker compose 变量；unitao_deploy.sh 由它生成 .env（.env 不进 git）
COMPOSE_PROJECT_NAME=<instance name>
# 容器名；同一 unitao 网络里的 Data Service 用 http://<它> 访问本实例
UNITAO_NAME=<instance name>
# 宿主机上的端口
UNITAO_PORT=<port>
# 容器以这个用户运行，写出的文件归该用户；不设置时以 root 运行
UNITAO_UID=<uid>
UNITAO_GID=<gid>
UNITAO_IMAGE=ghcr.io/howeyhuo/unitao-dev:latest
# 与 Data Service 共用的 Docker 网络（unitao_deploy.sh 没有就建）
UNITAO_NETWORK=unitao_net
